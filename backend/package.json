{
  "name": "@fingerprint/backend",
  "version": "0.1.0",
  "description": "Fingerprint off-chain services: indexer + attestor relay",
  "main": "dist/index.js",
  "scripts": {
    "dev:indexer": "ts-node-dev --respawn src/indexer/server.ts",
    "dev:relay": "ts-node-dev --respawn src/relay/server.ts",
    "build": "tsc",
    "db:migrate": "ts-node src/db/migrate.ts",
    "setup:helius": "ts-node scripts/setup-helius-webhook.ts",
    "test:relay": "ts-node scripts/test-relay.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/web3.js": "^1.87.6",
    "@fingerprint/sdk": "file:../sdk",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "pg": "^8.11.3",
    "dotenv": "^16.4.1",
    "bs58": "^5.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.10.9",
    "@types/node": "^20.11.5",
    "@types/bs58": "^4.0.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}